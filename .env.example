# Anchor process environment only.
# NEVER export GITHUB_TOKEN into agent tmux panes.
# Copy to `.env` (gitignored) and fill real values. Do not commit `.env`.

# Required
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_USER=your-github-username

# Optional — GitHub.com (defaults) or GitHub Enterprise Server
# GITHUB_HOST=github.com
# GITHUB_API_URL=https://api.github.com
# Enterprise example:
# GITHUB_HOST=github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3

# Optional (Compose also sets PROJECTS_DIR / TMUX_SESSION / PORT)
PROJECTS_DIR=/home/agent/projects
TMUX_SESSION=agents
CURSOR_CMD=cursor-agent
OPENCODE_CMD=opencode
PORT=8080
LOG_LEVEL=info
